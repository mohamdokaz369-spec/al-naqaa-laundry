# انسخ هذا الملف إلى .env.local وعبّئ القيم الحقيقية من لوحة Supabase.
# .env.local (وكل .env*) مستثنى من git عبر .gitignore — لا تدفعه أبدًا.

# ─── عام — آمن للكشف في المتصفح ───────────────────────────────────────────────
# Project Settings → API → Project URL / anon public key
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── سرّي — خادم فقط، لا تضف NEXT_PUBLIC_ أبدًا ────────────────────────────────
# Project Settings → API → service_role key
# يُستخدم فقط داخل app/api/** (إنشاء الطلبات العامة + تتبع الطلب).
# هذا المفتاح يتجاوز RLS بالكامل — تسريبه يعادل تسريب القاعدة كاملة.
SUPABASE_SERVICE_ROLE_KEY=

# رقم واتساب الحقيقي بصيغة دولية؛ يترك فارغًا حتى التأكيد.
NEXT_PUBLIC_BUSINESS_WHATSAPP_NUMBER=972527983320

# Server-only notification providers; leave empty until official accounts are configured.
FIREBASE_SERVICE_ACCOUNT_JSON=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_CUSTOMER_TEMPLATE=
WHATSAPP_ADMIN_TEMPLATE=
WHATSAPP_ADMIN_PHONE=972527983320
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
NOTIFICATION_WORKER_SECRET=
NOTIFICATION_DISPATCH_URL=https://al-naqaa-laundry.vercel.app/api/notifications/dispatch
